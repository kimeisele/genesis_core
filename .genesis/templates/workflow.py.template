def register_workflow(workflow_name: str = "my_workflow"):
    """
    Register the workflow with its steps.

    Args:
        workflow_name: Name of the workflow to register

    Returns:
        The registered workflow definition
    """
    # Register step handlers
    process.register_step_handler(f"{workflow_name}_validate", step_validate)
    process.register_step_handler(f"{workflow_name}_process", step_process)
    process.register_step_handler(f"{workflow_name}_finalize", step_finalize)

    # Define the process
    workflow = process.define_process(workflow_name, [
        f"{workflow_name}_validate",
        f"{workflow_name}_process",
        f"{workflow_name}_finalize"
    ])

    return workflow


def execute_workflow(input_entity: Any, workflow_name: str = "my_workflow") -> Any:
    """
    Execute the complete workflow.

    Args:
        input_entity: The entity to process through the workflow
        workflow_name: Name of the workflow to execute

    Returns:
        The final processed entity

    Example:
        >>> from genesis_core import entity
        >>> my_entity = entity.create_entity("MyType", {"data": "value"})
        >>> result = execute_workflow(my_entity)
        >>> print(result)
    """
    result = process.execute_process(workflow_name, input_entity)
    return result


